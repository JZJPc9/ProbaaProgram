<%- include('partials/head', { titulo: 'Evaluación en Curso' }) %>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <div>
        <h1><%= banco.nombre %></h1>
        <p class="muted">Responde todas las preguntas y presiona "Calificar Examen".</p>
    </div>
    <span class="badge"><%= preguntas.length %> reactivos</span>
</div>

<form action="/calificar" method="POST">
    <input type="hidden" name="bancoId" value="<%= banco.id %>">

    <% preguntas.forEach((p, index) => { %>
        <div class="card">
            <h3><%= index + 1 %>. <%- p.texto_pregunta %></h3>
            <div style="margin-top:14px;">
                <% p.opciones.forEach(opcion => { %>
                    <label class="opcion-label">
                        <input type="radio" name="<%= p.id %>" value="<%= opcion %>" required>
                        <span><%- opcion %></span>
                    </label>
                <% }) %>
            </div>
        </div>
    <% }) %>

    <button type="submit" class="btn btn-accent" style="width:100%; padding:14px; font-size:1.05rem;">
        Calificar Examen
    </button>
</form>

<%- include('partials/footer') %>