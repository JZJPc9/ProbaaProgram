<%- include('partials/head', { titulo: banco.nombre }) %>

<div style="margin-bottom:20px;">
    <a href="/panel-admin" class="btn btn-outline" style="margin-bottom:12px;">← Volver al Panel</a>
    <h1><%= banco.nombre %></h1>
    <p class="muted"><%= banco.descripcion %></p>
</div>

<div class="card">
    <h2>Agregar Nueva Pregunta</h2>
    <div class="latex-hint">
        <strong>Tip LaTeX:</strong> Encierra las fórmulas entre signos de pesos <code>$ ... $</code>. 
        Ejemplos: <code>$\frac{n!}{r!(n-r)!}$</code>, <code>$P(A \cup B)$</code>, <code>$\binom{n}{r}$</code>, <code>$\lambda t$</code>.
    </div>

    <form action="/banco/<%= banco.id %>/agregar-pregunta" method="POST">
        <div class="form-group">
            <label>Enunciado de la pregunta:</label>
            <textarea name="texto_pregunta" rows="3" required></textarea>
        </div>

        <div class="grid-2" style="margin-top:0;">
            <div class="form-group">
                <label>Opción A:</label>
                <input type="text" id="opA" name="opcionA" required>
            </div>
            <div class="form-group">
                <label>Opción B:</label>
                <input type="text" id="opB" name="opcionB" required>
            </div>
            <div class="form-group">
                <label>Opción C:</label>
                <input type="text" id="opC" name="opcionC" required>
            </div>
            <div class="form-group">
                <label>Opción D:</label>
                <input type="text" id="opD" name="opcionD" required>
            </div>
        </div>

        <div class="form-group">
            <label>Selecciona cuál es la opción correcta:</label>
            <select id="selectCorrecta" required>
                <option value="opA">Opción A</option>
                <option value="opB">Opción B</option>
                <option value="opC">Opción C</option>
                <option value="opD">Opción D</option>
            </select>
            <input type="hidden" name="correcta" id="inputCorrecta">
        </div>

        <button type="submit" class="btn btn-accent">Guardar Pregunta</button>
    </form>
</div>

<h2>Preguntas Registradas (<%= preguntas.length %>)</h2>
<% if (preguntas.length === 0) { %>
    <div class="card"><p>Este banco aún no tiene preguntas.</p></div>
<% } else { %>
    <% preguntas.forEach((p, index) => { %>
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
                <p style="font-weight:600;"><%= index + 1 %>. <%- p.texto_pregunta %></p>
                <form action="/pregunta/<%= p.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar esta pregunta?');">
                    <input type="hidden" name="banco_id" value="<%= banco.id %>">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
            <ul style="margin: 12px 0 12px 20px;">
                <% p.opciones.forEach(opcion => { %>
                    <li style="<%= opcion === p.respuesta_correcta ? 'color:#047857; font-weight:600;' : '' %>">
                        <%- opcion %> <%= opcion === p.respuesta_correcta ? '✓' : '' %>
                    </li>
                <% }) %>
            </ul>
        </div>
    <% }) %>
<% } %>

<script>
    // Sincroniza automáticamente el texto exacto de la opción elegida en el select
    const form = document.querySelector('form[action*="/agregar-pregunta"]');
    form.addEventListener('submit', () => {
        const selectedId = document.getElementById('selectCorrecta').value;
        document.getElementById('inputCorrecta').value = document.getElementById(selectedId).value;
    });
</script>

<%- include('partials/footer') %>