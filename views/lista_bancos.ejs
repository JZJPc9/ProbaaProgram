<%- include('partials/head', { titulo: 'Bancos Disponibles' }) %>
<%
    const cantFija = typeof cantidadFija !== 'undefined' ? cantidadFija : 5;
    const permitirElegir = typeof permitirElegirCantidad !== 'undefined' ? permitirElegirCantidad : false;
%>

<h1>Bancos de Preguntas</h1>
<% if (permitirElegir) { %>
    <p class="muted">Selecciona el tema y el número de reactivos para iniciar tu prueba.</p>
<% } %>

<% if (bancos.length === 0) { %>
    <div class="card"><p>Aún no hay bancos disponibles.</p></div>
<% } else { %>
    <div class="grid-2">
        <% bancos.forEach(banco => { %>
            <div class="card" style="display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <span class="badge"><%= banco.total_preguntas %> preguntas en banco</span>
                    <h2><%= banco.nombre %></h2>
                    <p class="muted"><%= banco.descripcion || 'Sin descripción' %></p>
                </div>

                <% if (banco.total_preguntas > 0) { %>
                    <form action="/examen/<%= banco.id %>" method="GET" style="margin-top:12px;">
                        <% if (permitirElegir) { %>
                            <div class="form-group">
                                <label>Cantidad de preguntas:</label>
                                <input
                                    type="number"
                                    name="n"
                                    min="1"
                                    max="<%= banco.total_preguntas %>"
                                    value="<%= Math.min(cantFija, banco.total_preguntas) %>"
                                >
                            </div>
                        <% } %>
                        <button type="submit" class="btn btn-accent" style="width:100%;">Iniciar Prueba</button>
                    </form>
                <% } else { %>
                    <button class="btn btn-outline" disabled>Sin reactivos aún</button>
                <% } %>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer') %>