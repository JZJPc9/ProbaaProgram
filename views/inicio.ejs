<%- include('partials/head', { titulo: 'Probabilidad y Estadística — Equipo 6' }) %>

<div class="card" style="text-align:center; padding: 44px 26px;">
    <span class="badge">Simulador Académico · Equipo 6</span>
    <h1>Probabilidad y Estadística</h1>
    <p class="muted" style="max-width: 540px; margin: 0 auto 24px;">
        Practica con <strong>10 reactivos aleatorios</strong> por unidad y obtén un resultado de inmediato.
    </p>
    <a href="/estudiante" class="btn btn-accent" style="padding: 13px 30px; font-size: 1.05rem;">
        Comenzar Práctica
    </a>

    <div class="syllabus-section">
        <div class="syllabus-header">
            <h2>Contenido Disponible</h2>
            <p class="muted" style="margin-bottom: 0; font-size: 0.92rem;">
                Temas incluidos en los bancos de reactivos del simulador
            </p>
        </div>

        <div class="grid-3">
            <div class="unit-card">
                <span class="unit-tag">Unidad 1</span>
                <ul class="unit-list">
                    <li>Generalidades</li>
                    <li>Elementos de análisis combinatorio</li>
                    <li>Axiomas de probabilidad</li>
                    <li>Probabilidad condicional</li>
                    <li>Eventos independientes y regla de la multiplicación</li>
                    <li>Regla de Bayes</li>
                </ul>
            </div>

            <div class="unit-card">
                <span class="unit-tag">Unidad 2</span>
                <ul class="unit-list">
                    <li>Definición de variables</li>
                    <li>Definición de distribución de VAD y de VAC</li>
                    <li>Obtención de la expresión analítica o fórmula de una distribución</li>
                    <li>Construcción de tablas</li>
                </ul>
            </div>

            <div class="unit-card">
                <span class="unit-tag">Unidad 3</span>
                <ul class="unit-list">
                    <li>Distribución binomial</li>
                    <li>Distribución binomial negativa</li>
                    <li>Distribución geométrica</li>
                    <li>Distribución hipergeométrica</li>
                    <li>Distribución de Poisson</li>
                    <li>Distribución normal</li>
                </ul>
            </div>
        </div>
    </div>
</div>

