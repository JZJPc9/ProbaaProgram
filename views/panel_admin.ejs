<%- include('partials/head', { titulo: 'Panel de Administración' }) %>

<h1>Panel de Administración</h1>
<p class="muted">Crea nuevos bancos de preguntas o edita los reactivos existentes.</p>

<div class="card">
    <h2>Crear Nuevo Banco</h2>
    <form action="/crear-banco" method="POST">
        <div class="form-group">
            <label>Nombre del Banco (Ej. Unidad 3: Distribuciones Discretas):</label>
            <input type="text" name="nombre" required>
        </div>
        <div class="form-group">
            <label>Descripción:</label>
            <input type="text" name="descripcion">
        </div>
        <button type="submit" class="btn btn-primary">Guardar Banco</button>
    </form>
</div>

<h2>Bancos Existentes</h2>
<% if (bancos.length === 0) { %>
    <div class="card"><p>No hay bancos creados todavía.</p></div>
<% } else { %>
    <div class="grid-2">
        <% bancos.forEach(banco => { %>
            <div class="card" style="display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <span class="badge"><%= banco.total_preguntas %> reactivos</span>
                    <h3><%= banco.nombre %></h3>
                    <p class="muted"><%= banco.descripcion || 'Sin descripción' %></p>
                </div>
                <a href="/banco/<%= banco.id %>" class="btn btn-accent">Administrar Preguntas</a>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('partials/footer') %>