<%- include('partials/head', { titulo: 'Resultados' }) %>

<div class="score-box">
    <p style="opacity:0.85; margin-bottom:4px;">Resultado Final</p>
    <div class="num"><%= aciertos %> / <%= total %></div>
    <p style="margin-top:4px; font-weight:600;">
        Calificación: <%= Math.round((aciertos / total) * 100) %>%
    </p>
</div>

<h2>Revisión Detallada</h2>

<% resultados.forEach((r, i) => { %>
    <div class="res-item <%= r.esCorrecta ? 'res-correcta' : 'res-incorrecta' %>">
        <p style="font-weight:600; margin-bottom:8px;"><%= i + 1 %>. <%- r.texto %></p>
        <p><strong>Tu respuesta:</strong> <%- r.respondida %></p>
        <% if (!r.esCorrecta) { %>
            <p style="color:#991b1b; margin-top:4px;">
                <strong>Respuesta correcta:</strong> <%- r.correcta %>
            </p>
        <% } %>
    </div>
<% }) %>

<div style="display:flex; gap:12px; margin-top:24px;">
    <% if (bancoId) { %>
        <a href="/examen/<%= bancoId %>" class="btn btn-accent">Volver a intentar este banco</a>
    <% } %>
    <a href="/estudiante" class="btn btn-outline">Elegir otro banco</a>
</div>

<%- include('partials/footer') %>