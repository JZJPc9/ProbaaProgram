<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Resultados</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; max-width: 800px; margin: auto; }
        .resultado { margin-bottom: 20px; padding: 15px; border-radius: 5px; }
        .correcto { background-color: #d8f3dc; border-left: 5px solid #2d6a4f; }
        .incorrecto { background-color: #ffddd2; border-left: 5px solid #e29578; }
        a button { padding: 10px 20px; background: #0077b6; color: white; border: none; cursor: pointer; }
    </style>
</head>
<body>
    <h1>Calificación Final</h1>
    <h2>Acertaste <%= aciertos %> de <%= total %> preguntas.</h2>

    <hr>
    <h3>Revisión de respuestas:</h3>
    
    <% resultados.forEach((r, i) => { %>
        <div class="resultado <%= r.esCorrecta ? 'correcto' : 'incorrecto' %>">
            <p><strong>Pregunta:</strong> <%= r.texto %></p>
            <p><strong>Tu respuesta:</strong> <%= r.respondida %></p>
            <% if (!r.esCorrecta) { %>
                <p style="color: #c1121f;"><strong>Respuesta correcta:</strong> <%= r.correcta %></p>
            <% } %>
        </div>
    <% }) %>

    <br>
    <a href="/estudiante"><button>Volver a los bancos</button></a>
</body>
</html>